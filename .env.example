NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Neon: DATABASE_URL = pooled endpoint (host contains "-pooler"), DIRECT_URL = same without "-pooler".
# Locally both can be the same URL.
DATABASE_URL=postgresql://astrolive:astrolive@localhost:5432/astrolive
DIRECT_URL=postgresql://astrolive:astrolive@localhost:5432/astrolive

# Secrets: generate each with `openssl rand -base64 32`. Never commit real values.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
# HMAC key for OTP hashes and phone lookup hashes.
HASH_PEPPER=change-me-pepper-at-least-32-chars-long
# 32-byte key, base64, for AES-256-GCM encryption of phone numbers.
PII_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# SMS: "console" logs the OTP (development only); "apitxt" (primary) or "fast2sms" send real SMS.
SMS_PROVIDER=console
APITXT_API_KEY=
# Optional SMS template id from the apitxt dashboard (empty = account default template).
APITXT_TEMPLATE_ID=
FAST2SMS_API_KEY=
FAST2SMS_OTP_TEMPLATE_ID=

# Current legal document versions users must accept at login.
TERMS_VERSION=v1
PRIVACY_VERSION=v1

# Optional: comma-separated IPs allowed to reach /admin (empty = any IP; login still needs password + TOTP).
ADMIN_IP_ALLOWLIST=

# Trust X-Forwarded-For from this many proxies (set to 1 behind one load balancer).
TRUST_PROXY_HOPS=0
