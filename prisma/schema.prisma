// AstroLive schema. Tables are snake_case; Prisma models are PascalCase.
// Every timestamp is written by the app clock (src/lib/clock.ts), never by the DB,
// so tests can control time and all modules agree on "now".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon: pooled endpoint for the running app, direct endpoint for migrations
  // (migrate takes session-level advisory locks, which a transaction pooler can't hold).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  active
  suspended
  deletion_pending
  deleted
}

enum Language {
  hi
  en
}

enum ConsentDoc {
  terms
  privacy
  age_18
  marketing
}

enum OtpPurpose {
  login
}

enum OtpDelivery {
  pending
  sent
  failed
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  // HMAC of the normalised mobile number: used for lookup and uniqueness.
  phoneHash     String     @unique @map("phone_hash")
  // AES-256-GCM ciphertext of the mobile number (spec §15: phone encrypted at rest).
  phoneEnc      String     @map("phone_enc")
  phoneLast4    String     @map("phone_last4") @db.Char(4)
  name          String?
  language      Language   @default(hi)
  status        UserStatus @default(active)
  // Roles this account can act as. "astrologer" is granted by onboarding, never by login.
  roles         String[]   @default(["user"])
  ageDeclaredAt DateTime?  @map("age_declared_at")
  createdAt     DateTime   @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  consents     Consent[]
  authSessions AuthSession[]

  @@map("users")
}

model Consent {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  docType     ConsentDoc @map("doc_type")
  docVersion  String     @map("doc_version")
  channel     String // e.g. "app_login"
  ip          String?
  grantedAt   DateTime   @map("granted_at")
  withdrawnAt DateTime?  @map("withdrawn_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, docType])
  @@map("consents")
}

model OtpRequest {
  id          String      @id @default(uuid()) @db.Uuid
  phoneHash   String      @map("phone_hash")
  purpose     OtpPurpose  @default(login)
  // HMAC of the code. The plain code is never stored.
  codeHash    String      @map("code_hash")
  expiresAt   DateTime    @map("expires_at")
  attempts    Int         @default(0)
  consumedAt  DateTime?   @map("consumed_at")
  // Set when attempts hit the limit: the number can't send or verify until then.
  lockedUntil DateTime?   @map("locked_until")
  ip          String?
  deviceId    String?     @map("device_id")
  delivery    OtpDelivery @default(pending)
  // Raw provider response, kept for debugging delivery (no OTP inside).
  providerRef Json?       @map("provider_ref")
  createdAt   DateTime    @map("created_at")

  @@index([phoneHash, createdAt])
  @@index([ip, createdAt])
  @@index([deviceId, createdAt])
  @@map("otp_requests")
}

// One row per signed-in device. A user has at most one active session (spec §8.20).
model AuthSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String    @map("device_id")
  platform     String?
  appVersion   String?   @map("app_version")
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @map("created_at")
  lastUsedAt   DateTime  @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

// Rotating refresh tokens. Presenting a used token again revokes the whole session.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @map("created_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}
