// AstroLive schema. Tables are snake_case; Prisma models are PascalCase.
// Every timestamp is written by the app clock (src/lib/clock.ts), never by the DB,
// so tests can control time and all modules agree on "now".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: pooled endpoint for the running app, direct endpoint for migrations
  // (migrate takes session-level advisory locks, which a transaction pooler can't hold).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  active
  suspended
  deletion_pending
  deleted
}

enum Language {
  hi
  en
}

enum ConsentDoc {
  terms
  privacy
  age_18
  marketing
  provider_conduct // astrologer code of conduct, accepted at application submit
  provider_terms // astrologer commercial terms (40% platform share, payouts, strikes)
}

// Which app a login session belongs to. Signing in to one app never signs the other out.
enum AuthApp {
  user
  provider
}

enum OtpPurpose {
  login
}

enum OtpDelivery {
  pending
  sent
  failed
}

enum Gender {
  female
  male
  other
  undisclosed
}

// "I don't know my exact time" asks for a rough window instead (spec §8.4).
enum BirthTimeAccuracy {
  exact
  morning
  afternoon
  evening
  night
  unknown
}

enum BudgetBand {
  under_20
  from_20_to_50
  from_50_to_100
  above_100
  no_preference
}

enum GenderPreference {
  woman
  man
  no_preference
}

enum ConsultExperience {
  many
  few
  never
}

enum DataRequestType {
  export
  erasure
}

enum DataRequestStatus {
  received
  in_progress
  completed
  cancelled
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  // HMAC of the normalised mobile number: used for lookup and uniqueness.
  phoneHash     String     @unique @map("phone_hash")
  // AES-256-GCM ciphertext of the mobile number (spec §15: phone encrypted at rest).
  phoneEnc      String     @map("phone_enc")
  phoneLast4    String     @map("phone_last4") @db.Char(4)
  name          String?
  language      Language   @default(hi)
  status        UserStatus @default(active)
  // Roles this account can act as. "astrologer" is granted by onboarding, never by login.
  roles         String[]   @default(["user"])
  ageDeclaredAt DateTime?  @map("age_declared_at")
  createdAt     DateTime   @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  consents      Consent[]
  authSessions  AuthSession[]
  birthProfiles BirthProfile[]
  astrologer    Astrologer?
  uploads       Upload[]
  preferences   UserPreference?
  dataRequests  DataRequest[]

  @@map("users")
}

// Topic categories (spec §7.10). Data, not code: Admin edits them later.
model Category {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  nameEn        String   @map("name_en")
  nameHi        String   @map("name_hi")
  descriptionEn String?  @map("description_en")
  descriptionHi String?  @map("description_hi")
  sortOrder     Int      @map("sort_order")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

// Indian cities and towns from GeoNames (CC BY 4.0). Reference data, seeded.
model Place {
  id         Int     @id // GeoNames id
  name       String
  asciiName  String  @map("ascii_name")
  // A Devanagari alias from GeoNames, used for search only (not always the common name).
  aliasHi    String? @map("alias_hi")
  state      String
  // Lower-cased ascii name for prefix search.
  searchName String  @map("search_name")
  lat        Decimal @db.Decimal(8, 5)
  lng        Decimal @db.Decimal(8, 5)
  tzId       String  @map("tz_id")
  population Int

  astrologers Astrologer[]

  @@index([searchName])
  @@map("places")
}

// Spec §8.4. Birth details are personal data: only the owner and the astrologer
// they consult may see them.
model BirthProfile {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  isSelf        Boolean           @map("is_self")
  label         String
  name          String
  gender        Gender
  dob           DateTime          @db.Date
  // Local clock time at the birth place, "HH:MM". Null when not known exactly.
  tob           String?
  tobAccuracy   BirthTimeAccuracy @map("tob_accuracy")
  placeId       Int?              @map("place_id")
  placeText     String            @map("place_text")
  lat           Decimal           @db.Decimal(8, 5)
  lng           Decimal           @db.Decimal(8, 5)
  // IANA zone; historical offsets come from the tz database at chart time.
  tzId          String            @map("tz_id")
  maritalStatus String?           @map("marital_status")
  occupation    String?
  createdAt     DateTime          @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("birth_profiles")
}

// Answers to the skippable onboarding questions (spec §8.2.1). Sensitive:
// used only for ordering results, never shared with astrologers or used for marketing.
model UserPreference {
  userId         String             @id @map("user_id") @db.Uuid
  topics         String[] // category slugs, max 3
  languages      String[] // hi | en | hinglish, max 2
  modes          String[] // chat | voice | video | live
  budgetBand     BudgetBand?        @map("budget_band")
  genderPref     GenderPreference?  @map("gender_pref")
  firstTime      ConsultExperience? @map("first_time")
  showEveryone   Boolean            @default(false) @map("show_everyone")
  answeredAt     DateTime?          @map("answered_at")
  skippedAt      DateTime?          @map("skipped_at")
  source         String // device_sync | account
  consentVersion String             @map("consent_version")
  updatedAt      DateTime           @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_preferences")
}

// ---------- Admin (exactly one admin account) ----------

model Admin {
  id            String   @id @default(uuid()) @db.Uuid
  // Always true and unique: the database itself allows only one admin row.
  singleton     Boolean  @unique @default(true)
  email         String   @unique
  passwordHash  String   @map("password_hash")
  // TOTP secret, encrypted with the PII key.
  totpSecretEnc String   @map("totp_secret_enc")
  // Last accepted TOTP time-step, so a code can't be replayed.
  lastTotpStep  BigInt   @default(0) @map("last_totp_step")
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  passwordAt    DateTime @map("password_at")

  sessions AdminSession[]

  @@map("admins")
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @map("created_at")
  lastUsedAt DateTime  @map("last_used_at")
  // Set when a fresh TOTP code was entered; sensitive actions need this to be recent.
  stepUpAt   DateTime? @map("step_up_at")
  revokedAt  DateTime? @map("revoked_at")

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId, revokedAt])
  @@map("admin_sessions")
}

model AdminLoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  ip        String
  success   Boolean
  createdAt DateTime @map("created_at")

  @@index([ip, createdAt])
  @@map("admin_login_attempts")
}

// Append-only: a database trigger rejects UPDATE and DELETE (see the migration).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorType  String   @map("actor_type") // admin | system | user
  actorId    String?  @map("actor_id")
  action     String // e.g. admin.login, setting.scheduled
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Versioned business numbers (Admin → Settings, board Y13). The value in force is the
// latest version whose effectiveFrom has passed. Versions are never edited; a scheduled
// version can be cancelled before it takes effect.
model Setting {
  id            String    @id @default(uuid()) @db.Uuid
  key           String
  version       Int
  value         Json
  effectiveFrom DateTime  @map("effective_from")
  reason        String
  createdBy     String    @map("created_by") // admin id, or "system" for defaults
  createdAt     DateTime  @map("created_at")
  cancelledAt   DateTime? @map("cancelled_at")

  @@unique([key, version])
  @@index([key, effectiveFrom])
  @@map("settings")
}

// DPDP rights requests. Fulfilment (export file, erasure job) belongs to the compliance module.
model DataRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  type        DataRequestType
  status      DataRequestStatus @default(received)
  // Erasure: when the cool-off ends and the job may run. Export: response deadline.
  dueAt       DateTime          @map("due_at")
  createdAt   DateTime          @map("created_at")
  completedAt DateTime?         @map("completed_at")
  cancelledAt DateTime?         @map("cancelled_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, status])
  @@map("data_requests")
}

model Consent {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  docType     ConsentDoc @map("doc_type")
  docVersion  String     @map("doc_version")
  channel     String // e.g. "app_login"
  ip          String?
  grantedAt   DateTime   @map("granted_at")
  withdrawnAt DateTime?  @map("withdrawn_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, docType])
  @@map("consents")
}

model OtpRequest {
  id          String      @id @default(uuid()) @db.Uuid
  phoneHash   String      @map("phone_hash")
  purpose     OtpPurpose  @default(login)
  // HMAC of the code. The plain code is never stored.
  codeHash    String      @map("code_hash")
  expiresAt   DateTime    @map("expires_at")
  attempts    Int         @default(0)
  consumedAt  DateTime?   @map("consumed_at")
  // Set when attempts hit the limit: the number can't send or verify until then.
  lockedUntil DateTime?   @map("locked_until")
  ip          String?
  deviceId    String?     @map("device_id")
  delivery    OtpDelivery @default(pending)
  // Raw provider response, kept for debugging delivery (no OTP inside).
  providerRef Json?       @map("provider_ref")
  createdAt   DateTime    @map("created_at")

  @@index([phoneHash, createdAt])
  @@index([ip, createdAt])
  @@index([deviceId, createdAt])
  @@map("otp_requests")
}

// One row per signed-in device. A user has at most one active session (spec §8.20).
model AuthSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String    @map("device_id")
  platform     String?
  appVersion   String?   @map("app_version")
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @map("created_at")
  lastUsedAt   DateTime  @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  app          AuthApp   @default(user)

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

// Rotating refresh tokens. Presenting a used token again revokes the whole session.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @map("created_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Astrologers (build step 3; boards X1, X2, X4, Y2; spec §7.10, §9, §11.3)
// ---------------------------------------------------------------------------

enum AstrologerStatus {
  draft // filling the 5-step application
  submitted // waiting for the admin
  needs_changes // admin asked for specific fixes
  interview_scheduled
  approved // listed and can go online
  rejected
  suspended
}

enum ConsultMode {
  chat
  voice
  video
}

enum IdType {
  aadhaar
  passport
  driving_licence
  voter_id
}

enum UploadPurpose {
  photo
  pan
  id_front
  id_back
  experience_proof
  intro_video
}

enum UploadStatus {
  pending // upload link issued
  uploaded // file confirmed in storage
}

enum DocReview {
  pending
  verified
  rejected
}

enum RateStatus {
  requested
  approved
  rejected
  cancelled
}

enum RevisionStatus {
  pending
  approved
  rejected
}

/// "How the astrologer works" (Vedic, KP, Tarot…). Separate from topic categories (spec §7.10).
model MethodTag {
  slug      String  @id
  nameEn    String  @map("name_en")
  nameHi    String  @map("name_hi")
  sortOrder Int     @map("sort_order")
  active    Boolean @default(true)

  @@map("method_tags")
}

/// One per applicant or astrologer, linked to their user account (same phone login).
model Astrologer {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @unique @map("user_id") @db.Uuid
  status                AstrologerStatus @default(draft)
  // Step 1: basics
  legalName             String?          @map("legal_name")
  displayName           String?          @map("display_name")
  gender                Gender?
  placeId               Int?             @map("place_id")
  languages             String[]
  experienceYears       Int?             @map("experience_years")
  photoUploadId         String?          @map("photo_upload_id") @db.Uuid
  // Step 2: speciality and what they want to offer
  methods               String[]
  primaryCategory       String?          @map("primary_category")
  secondaryCategories   String[]         @map("secondary_categories")
  capabilitiesRequested String[]         @map("capabilities_requested")
  bio                   String?
  // Step 3: documents
  idType                IdType?          @map("id_type")
  panUploadId           String?          @map("pan_upload_id") @db.Uuid
  idFrontUploadId       String?          @map("id_front_upload_id") @db.Uuid
  idBackUploadId        String?          @map("id_back_upload_id") @db.Uuid
  proofUploadId         String?          @map("proof_upload_id") @db.Uuid
  introVideoUploadId    String?          @map("intro_video_upload_id") @db.Uuid
  // Decided by the admin
  capabilities          String[]
  listed                Boolean          @default(false)
  interviewAt           DateTime?        @map("interview_at")
  interviewLink         String?          @map("interview_link")
  rejectReason          String?          @map("reject_reason")
  reapplyAfter          DateTime?        @map("reapply_after")
  suspendReason         String?          @map("suspend_reason")
  submittedAt           DateTime?        @map("submitted_at")
  approvedAt            DateTime?        @map("approved_at") // starts the new-astrologer rate cap
  createdAt             DateTime         @map("created_at")
  updatedAt             DateTime         @map("updated_at")

  user          User                     @relation(fields: [userId], references: [id])
  place         Place?                   @relation(fields: [placeId], references: [id])
  kyc           AstrologerKyc?
  availability  AstrologerAvailability?
  rates         AstrologerRate[]
  events        AstrologerEvent[]
  fixes         ApplicationFix[]
  revisions     ProfileRevision[]
  scheduleSlots AstrologerScheduleSlot[]

  @@index([status, submittedAt])
  @@index([listed, primaryCategory])
  @@map("astrologers")
}

/// PAN and bank details, encrypted like phone numbers; last 4 digits kept for display.
model AstrologerKyc {
  astrologerId     String   @id @map("astrologer_id") @db.Uuid
  panEnc           String   @map("pan_enc")
  panLast4         String   @map("pan_last4")
  bankAccountEnc   String   @map("bank_account_enc")
  bankAccountLast4 String   @map("bank_account_last4")
  ifsc             String
  accountHolder    String?  @map("account_holder")
  gstin            String?
  updatedAt        DateTime @map("updated_at")

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])

  @@map("astrologer_kyc")
}

/// Every rate ever asked for or set. The rate in force is the latest approved one whose effectiveFrom has passed.
model AstrologerRate {
  id            String      @id @default(uuid()) @db.Uuid
  astrologerId  String      @map("astrologer_id") @db.Uuid
  mode          ConsultMode
  ratePaise     Int         @map("rate_paise")
  status        RateStatus
  effectiveFrom DateTime?   @map("effective_from")
  note          String?
  createdAt     DateTime    @map("created_at")
  decidedAt     DateTime?   @map("decided_at")

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])

  @@index([astrologerId, mode, status])
  @@map("astrologer_rates")
}

/// The application timeline the astrologer sees (X1-4) and the admin reviews.
model AstrologerEvent {
  id           String   @id @default(uuid()) @db.Uuid
  astrologerId String   @map("astrologer_id") @db.Uuid
  type         String
  note         String?
  actor        String // astrologer | admin | system
  createdAt    DateTime @map("created_at")

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])

  @@index([astrologerId, createdAt])
  @@map("astrologer_events")
}

/// "One thing to fix": specific, actionable requests from the admin (X1-4 note 2).
model ApplicationFix {
  id           String    @id @default(uuid()) @db.Uuid
  astrologerId String    @map("astrologer_id") @db.Uuid
  field        String
  message      String
  createdAt    DateTime  @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])

  @@index([astrologerId, resolvedAt])
  @@map("application_fixes")
}

/// Profile edits after approval go to review; the live profile stays until approved (X4-2 note 4).
model ProfileRevision {
  id           String         @id @default(uuid()) @db.Uuid
  astrologerId String         @map("astrologer_id") @db.Uuid
  changes      Json
  status       RevisionStatus @default(pending)
  note         String?
  createdAt    DateTime       @map("created_at")
  decidedAt    DateTime?      @map("decided_at")

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])

  @@index([status, createdAt])
  @@map("profile_revisions")
}

/// Per-mode online switches (X2-1). A mode only counts if the admin granted it.
model AstrologerAvailability {
  astrologerId      String    @id @map("astrologer_id") @db.Uuid
  chat              Boolean   @default(false)
  voice             Boolean   @default(false)
  video             Boolean   @default(false)
  awayUntil         DateTime? @map("away_until")
  /// Weekly schedule (X4-4): inside a slot the schedule's modes count as online.
  scheduleEnabled   Boolean   @default(false) @map("schedule_enabled")
  scheduleModes     String[]  @map("schedule_modes")
  /// A manual switch during a scheduled slot wins until that slot ends.
  scheduleSkipUntil DateTime? @map("schedule_skip_until")
  updatedAt         DateTime  @map("updated_at")

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])

  @@map("astrologer_availability")
}

/// One block of weekly hours, in India time. Overnight hours are two slots.
model AstrologerScheduleSlot {
  id           String @id @default(uuid()) @db.Uuid
  astrologerId String @map("astrologer_id") @db.Uuid
  /// ISO weekday: 1 = Monday … 7 = Sunday.
  weekday      Int
  /// Minutes after midnight, India time; start < end.
  startMinute  Int    @map("start_minute")
  endMinute    Int    @map("end_minute")

  astrologer Astrologer @relation(fields: [astrologerId], references: [id])

  @@index([astrologerId, weekday])
  @@map("astrologer_schedule_slots")
}

/// Files uploaded straight to object storage with a short-lived link. Documents carry the admin's review.
model Upload {
  id          String        @id @default(uuid()) @db.Uuid
  ownerUserId String        @map("owner_user_id") @db.Uuid
  purpose     UploadPurpose
  storageKey  String        @unique @map("storage_key")
  contentType String        @map("content_type")
  sizeBytes   Int           @map("size_bytes")
  status      UploadStatus  @default(pending)
  review      DocReview     @default(pending)
  reviewNote  String?       @map("review_note")
  reviewedAt  DateTime?     @map("reviewed_at")
  createdAt   DateTime      @map("created_at")
  uploadedAt  DateTime?     @map("uploaded_at")

  owner User @relation(fields: [ownerUserId], references: [id])

  @@index([ownerUserId, purpose])
  @@map("uploads")
}
