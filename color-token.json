  "rules": [
    "Primary (ink) is the only filled button colour. Any button that spends money shows the amount, for example 'Pay ₹905' or 'Chat ₹30/min'.",
    "Free actions and secondary actions are outlined (border colour, ink text).",
    "One accent (saffron) per screen area: selected chip, money meter, rating stars, links, banner pill. It is never a button fill on a white page.",
    "Turmeric yellow and violet are not used anywhere. They belong to competitors in this category.",
    "Colour is never the only signal. Success, error, LIVE and selected states also carry a tick, icon or words.",
    "Error uses the brick red with words and an icon. True red (live) is used for the LIVE badge only.",
    "Helpline and safety notes use info blue, never red.",
    "Verified ticks are ink, not blue or green.",
    "No gradients. Flat colour only.",
    "Do not use accent as small text on a coloured background other than white, accent-tint or ink. Check any new pair in both themes before shipping.",
    "Dark mode is checked on its own. Passing in light does not carry over.",
    "Filled rating stars use saffron, empty stars use the border grey. Stars are the trust signal on every astrologer row."
  ],
  "typography": {
    "family": "Noto Sans (Latin) + Noto Sans Devanagari (Hindi)",
    "weights": [400, 600, 700],
    "why": "One designed family across both scripts, covers the ₹ sign, and is the Android system font family so it needs no download on low-end phones.",
    "check_before_locking": "Hindi and English side by side at 14px and 16px on a cheap Android phone; ₹ sign and tabular numerals in prices and the money meter.",
    "use": {
      "price and meter": "600 or 700, tabular numerals",
      "body": "400, 14–16px",
      "headings": "700"
    }
  },
  "logo": {
    "wordmark": "Ink (#1B1B1A) on light, white on dark",
    "mark": "Saffron (#B5470A on light, #F28C45 on ink). One small mark, not a gradient.",
    "app_icon": "Ink square with the saffron mark. Stands out in a store grid of yellow and purple icons.",
    "must_work_in": [
      "one colour ink on white",
      "one colour white on ink",
      "one colour saffron on white (stamp, WhatsApp share)"
    ],
    "avoid": ["yellow", "violet", "gold gradients", "stars and moons as the symbol (the category cliché)"]
  }
}
